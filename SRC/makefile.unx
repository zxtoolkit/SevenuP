CXX = g++
WX_CONFIG ?= wx-config

PROGRAM = SevenuP

OBJECTS = $(PROGRAM).o TheFrame.o OpenFile.o

# Release builds pass LDFLAGS=-s; the symbol table is 15% of the binary.
LDFLAGS ?=

.SUFFIXES:	.o .cpp

.cpp.o :
	$(CXX) -O2 -std=c++17 -c `$(WX_CONFIG) --cxxflags` -o $@ $<

all:    $(PROGRAM)

$(PROGRAM):	$(OBJECTS)
	$(CXX) -o $(PROGRAM) $(OBJECTS) $(LDFLAGS) `$(WX_CONFIG) --libs core,base`

clean: 
	rm -f *.o $(PROGRAM)
