CXX = g++
WX_CONFIG ?= wx-config

PROGRAM = SevenuP

OBJECTS = $(PROGRAM).o TheFrame.o OpenFile.o

ARCHFLAGS ?=

# Must reach both compile and link, or the binary claims the build host's SDK.
MACOS_MIN ?=
MINFLAG := $(if $(MACOS_MIN),-mmacosx-version-min=$(MACOS_MIN))

# -std=c++17: wxWidgets 3 headers need C++11 or later; g++ may default to C++98.
CXXFLAGS:= -Os -std=c++17 $(ARCHFLAGS) $(MINFLAG) `$(WX_CONFIG) --cxxflags`
LDFLAGS:= $(ARCHFLAGS) $(MINFLAG)
# core,base only; the default also links xrc, html, qa, xml and net.
LDLIBS:=`$(WX_CONFIG) --libs core,base`

.SUFFIXES:	.o .cpp

all:    $(PROGRAM).app

$(PROGRAM).app: $(PROGRAM) Info.plist SevenUp.icns SevenuP.ini
	$(MAKE) -f makefile.osx bundle

# Assembles around an existing binary: the universal build lipos two slices first.
bundle:
	install -d $(PROGRAM).app/Contents
	install -d $(PROGRAM).app/Contents/MacOS
	install -d $(PROGRAM).app/Contents/Resources
	install -m 644 Info.plist $(PROGRAM).app/Contents
	install -m 644 SevenUp.icns $(PROGRAM).app/Contents/Resources
	install -m 644 SevenuP.ini $(PROGRAM).app/Contents/Resources
	install $(PROGRAM) $(PROGRAM).app/Contents/MacOS
	codesign --force --sign - $(PROGRAM).app

$(PROGRAM):	$(OBJECTS)
	$(CXX) $(LDFLAGS) -o $@ $^ $(LDLIBS)
.PHONY: all bundle clean

clean: 
	rm -f *.o $(PROGRAM)
	rm -Rf $(PROGRAM).app